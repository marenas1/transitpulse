TRANSITPULSE_FEED_NAME=nyct-1-2-3-4-5-6-7
TRANSITPULSE_FEED_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs
# Optional. The current subway endpoint accepted the request without one during Phase 1 capture.
TRANSITPULSE_API_KEY=
TRANSITPULSE_SAMPLE_LIMIT=10
TRANSITPULSE_REQUEST_TIMEOUT_MS=20000
# Set this only to run against a captured local protobuf instead of the live feed.
# TRANSITPULSE_INPUT_FILE=fixtures/mta-nyct-gtfs.bin

TRANSITPULSE_DATABASE_URL=postgresql://transitpulse:transitpulse@localhost:5433/transitpulse
TRANSITPULSE_DATABASE_POOL_MAX=4
TRANSITPULSE_STATIC_GTFS_FILE=fixtures/mta-gtfs-subway.zip
TRANSITPULSE_SERVICE_TIME_ZONE=America/New_York
TRANSITPULSE_POLL_INTERVAL_MS=30000
TRANSITPULSE_MAX_CYCLES=0
TRANSITPULSE_IMPORT_STATIC=true
# TRANSITPULSE_FEED_INPUT_FILE=fixtures/mta-nyct-gtfs.bin

TRANSITPULSE_API_HOST=127.0.0.1
TRANSITPULSE_API_PORT=8080
TRANSITPULSE_STALE_AFTER_INTERVALS=2
TRANSITPULSE_MINIMUM_RANKING_SAMPLES=100
# TRANSITPULSE_AGGREGATE_FROM=2026-08-10
# TRANSITPULSE_AGGREGATE_TO=2026-08-17
